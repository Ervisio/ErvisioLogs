{
  "id": "ervisio-logs",
  "name": "Ervisio Logs",
  "version": "0.0.0",
  "author": "Ervisio team",
  "description": "Install and run Ervisio Logs on this server, as a Docker Compose stack (shown in the Docker plugin) or as a systemd service. Data is never deleted by the plugin.",
  "homepage": "https://github.com/Ervisio/ErvisioLogs",
  "icon": "server",
  "color": "log",
  "entry": "index.js",
  "minCore": "0.5.0",
  "platforms": ["linux"],
  "visibleTo": { "groups": ["wheel", "sudo", "docker"] },
  "contributes": {
    "pages": [{ "id": "logs", "title": "Ervisio Logs", "icon": "server" }]
  },
  "capabilities": {
    "commands": [
      {
        "name": "docker-check",
        "description": "Show the Docker Compose version (checks that Docker and Compose v2 are available)",
        "argv": ["docker", "-H", "{env}", "compose", "version", "--short"],
        "admin": true,
        "adminUnlessGroup": "docker",
        "timeoutSec": 30,
        "remote": "docker"
      },
      {
        "name": "stacks-init",
        "description": "Create the shared stacks folder /opt/stacks used by the Docker plugin, writable by the docker group",
        "argv": ["install", "-d", "-m", "2775", "-g", "docker", "/opt/stacks"],
        "admin": true,
        "timeoutSec": 30
      },
      {
        "name": "stack-init",
        "description": "Create /opt/stacks/ervisio-logs, closed to users outside the docker group (it holds the stack's .env)",
        "argv": ["install", "-d", "-m", "2770", "-g", "docker", "/opt/stacks/ervisio-logs"],
        "admin": true,
        "timeoutSec": 30
      },
      {
        "name": "compose-up",
        "description": "Create or update the Ervisio Logs containers",
        "argv": ["docker", "-H", "{env}", "compose", "--project-name", "ervisio-logs", "--project-directory", "/opt/stacks/ervisio-logs", "-f", "/opt/stacks/ervisio-logs/compose.yaml", "up", "-d", "--remove-orphans"],
        "admin": true,
        "adminUnlessGroup": "docker",
        "timeoutSec": 600,
        "remote": "docker"
      },
      {
        "name": "compose-pull",
        "description": "Pull the Ervisio Logs images",
        "argv": ["docker", "-H", "{env}", "compose", "--project-name", "ervisio-logs", "--project-directory", "/opt/stacks/ervisio-logs", "-f", "/opt/stacks/ervisio-logs/compose.yaml", "pull"],
        "admin": true,
        "adminUnlessGroup": "docker",
        "timeoutSec": 600,
        "remote": "docker"
      },
      {
        "name": "compose-down",
        "description": "Stop and remove the Ervisio Logs containers; the volumes and their data stay",
        "argv": ["docker", "-H", "{env}", "compose", "--project-name", "ervisio-logs", "--project-directory", "/opt/stacks/ervisio-logs", "-f", "/opt/stacks/ervisio-logs/compose.yaml", "down", "--remove-orphans"],
        "admin": true,
        "adminUnlessGroup": "docker",
        "timeoutSec": 300,
        "remote": "docker"
      },
      {
        "name": "compose-ps",
        "description": "List the Ervisio Logs containers and their health",
        "argv": ["docker", "-H", "{env}", "compose", "--project-name", "ervisio-logs", "--project-directory", "/opt/stacks/ervisio-logs", "-f", "/opt/stacks/ervisio-logs/compose.yaml", "ps", "--all", "--format", "json"],
        "admin": true,
        "adminUnlessGroup": "docker",
        "timeoutSec": 30,
        "remote": "docker"
      },
      {
        "name": "compose-logs",
        "description": "Show the last 200 lines of the Ervisio Logs app container",
        "argv": ["docker", "-H", "{env}", "compose", "--project-name", "ervisio-logs", "--project-directory", "/opt/stacks/ervisio-logs", "-f", "/opt/stacks/ervisio-logs/compose.yaml", "logs", "--tail", "200", "--no-color", "migrate", "app"],
        "admin": true,
        "adminUnlessGroup": "docker",
        "timeoutSec": 30,
        "remote": "docker"
      },
      {
        "name": "standalone-install",
        "description": "Download the Ervisio Logs release this plugin was built for, check its SHA-256 and run its installer",
        "argv": ["bash", "/var/lib/ervisio/plugins/ervisio-logs/bin/standalone.sh", "install"],
        "admin": true,
        "timeoutSec": 600
      },
      {
        "name": "standalone-uninstall",
        "description": "Remove the Ervisio Logs service and binary; configuration, spool and databases stay",
        "argv": ["bash", "/var/lib/ervisio/plugins/ervisio-logs/bin/standalone.sh", "uninstall"],
        "admin": true,
        "timeoutSec": 120
      },
      {
        "name": "standalone-status",
        "description": "Show the state of the ervisio-logs service",
        "argv": ["systemctl", "show", "ervisio-logs.service", "--property=LoadState,ActiveState,SubState,UnitFileState"],
        "timeoutSec": 15
      },
      {
        "name": "standalone-version",
        "description": "Show the installed Ervisio Logs version",
        "argv": ["/usr/local/bin/ervisio-logs", "version"],
        "timeoutSec": 15
      },
      {
        "name": "standalone-health",
        "description": "Probe http://127.0.0.1:8080/healthz",
        "argv": ["/usr/local/bin/ervisio-logs", "healthcheck"],
        "timeoutSec": 15
      },
      {
        "name": "standalone-start",
        "description": "Start the ervisio-logs service",
        "argv": ["systemctl", "start", "ervisio-logs.service"],
        "admin": true,
        "timeoutSec": 120
      },
      {
        "name": "standalone-restart",
        "description": "Restart the ervisio-logs service",
        "argv": ["systemctl", "restart", "ervisio-logs.service"],
        "admin": true,
        "timeoutSec": 120
      },
      {
        "name": "standalone-stop",
        "description": "Stop the ervisio-logs service",
        "argv": ["systemctl", "stop", "ervisio-logs.service"],
        "admin": true,
        "timeoutSec": 60
      },
      {
        "name": "standalone-logs",
        "description": "Show the last 200 journal lines of the ervisio-logs service",
        "argv": ["journalctl", "-u", "ervisio-logs.service", "-n", "200", "--no-pager", "-o", "short-iso"],
        "admin": true,
        "adminUnlessGroup": "systemd-journal",
        "timeoutSec": 30
      }
    ],
    "files": {
      "read": [
        { "path": "/opt/stacks/ervisio-logs", "admin": true, "adminUnlessGroup": "docker" },
        { "path": "/etc/ervisio-logs", "admin": true }
      ],
      "write": [
        { "path": "/opt/stacks/ervisio-logs", "admin": true, "adminUnlessGroup": "docker" },
        { "path": "/etc/ervisio-logs", "admin": true },
        { "path": "~/.config/ervisio/plugins/ervisio-logs", "create": true }
      ]
    }
  }
}
