# Copy to .env (git-ignored) with scripts/gen-env.sh, which fills the secrets with random values.
# No default credentials exist: the stack refuses to start without them.

# development | production. Production refuses placeholder secrets, PostgreSQL sslmode=disable
# and a non-https ERVISIO_LOGS_PUBLIC_URL.
ERVISIO_LOGS_ENV=development
ERVISIO_LOGS_LOG_LEVEL=info
ERVISIO_LOGS_PORT=8080

# Required.
POSTGRES_PASSWORD=change_me
CLICKHOUSE_PASSWORD=change_me
# At least 32 characters; keys the HMAC of stored API tokens: changing it invalidates them.
ERVISIO_LOGS_SECRET_KEY=change_me
# Externally visible base URL (OAuth redirect URIs, cookie Secure flag).
ERVISIO_LOGS_PUBLIC_URL=http://localhost:8080

# Store connections. The bundled PostgreSQL has no TLS: production needs a full DSN to a TLS-enabled
# server, or TLS configured on the bundled one plus POSTGRES_SSLMODE.
# POSTGRES_SSLMODE=disable
# ERVISIO_LOGS_POSTGRES_DSN=postgres://user:password@db.example.com:5432/ervisio_logs?sslmode=verify-full
# ERVISIO_LOGS_CLICKHOUSE_ADDR=clickhouse:9000
# ERVISIO_LOGS_CLICKHOUSE_TLS=false

# Optional authentication settings.
# ERVISIO_LOGS_OPEN_REGISTRATION=false
# Authorises the first admin account; generated and logged at start-up when unset.
# ERVISIO_LOGS_SETUP_CODE=
# ERVISIO_LOGS_SESSION_TTL=336h
# Enable only behind a reverse proxy that sets X-Forwarded-For itself.
# ERVISIO_LOGS_TRUST_PROXY=false

# Optional OAuth providers: a provider is enabled by its client id and then needs its secret.
# ERVISIO_LOGS_GOOGLE_CLIENT_ID=
# ERVISIO_LOGS_GOOGLE_CLIENT_SECRET=
# ERVISIO_LOGS_COGNITO_CLIENT_ID=
# ERVISIO_LOGS_COGNITO_CLIENT_SECRET=
# ERVISIO_LOGS_COGNITO_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
# ERVISIO_LOGS_DISCORD_CLIENT_ID=
# ERVISIO_LOGS_DISCORD_CLIENT_SECRET=

# Ingestion. The spool is the write-ahead log for acknowledged events (Compose mounts a volume
# at the default path). When it reaches SPOOL_MAX_BYTES, ingest answers 503 with Retry-After.
# ERVISIO_LOGS_SPOOL_DIR=/var/lib/ervisio-logs/spool
# ERVISIO_LOGS_SPOOL_MAX_BYTES=1073741824
# Events stamped further in the future, or older, than these limits are rejected.
# ERVISIO_LOGS_INGEST_MAX_FUTURE_SKEW=5m
# ERVISIO_LOGS_INGEST_MAX_PAST_AGE=168h
# Archive (ADR 0008): the archiver runs every ARCHIVE_INTERVAL (0 disables it) and seals a
# stream-day ARCHIVE_GRACE after it ends; late events are re-archived every ARCHIVE_LATE_INTERVAL.
# ERVISIO_LOGS_ARCHIVE_INTERVAL=5m
# ERVISIO_LOGS_ARCHIVE_GRACE=1h
# ERVISIO_LOGS_ARCHIVE_LATE_INTERVAL=6h
# ERVISIO_LOGS_ARCHIVE_CACHE_DIR=/var/lib/ervisio-logs/cache
# Alerts and exports (ADR 0010). ALERTS_INTERVAL=0 disables alert evaluation. Webhooks to http or
# to private addresses are refused unless WEBHOOK_ALLOW_PRIVATE=true (LAN receivers only).
# ERVISIO_LOGS_ALERTS_INTERVAL=30s
# ERVISIO_LOGS_ALERTS_HISTORY_RETENTION=720h
# ERVISIO_LOGS_WEBHOOK_ALLOW_PRIVATE=false
# ERVISIO_LOGS_EXPORT_MAX_ROWS=1000000
# Bearer token for GET /metrics. Without it /metrics answers only in development.
# ERVISIO_LOGS_METRICS_TOKEN=

# Development overlay (deploy/compose.dev.yaml) host ports, bound to 127.0.0.1
# DEV_POSTGRES_PORT=5432
# DEV_CLICKHOUSE_HTTP_PORT=8123
# DEV_CLICKHOUSE_NATIVE_PORT=9000
