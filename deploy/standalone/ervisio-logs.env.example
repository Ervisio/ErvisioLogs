# Ervisio Logs standalone configuration: /etc/ervisio-logs/ervisio-logs.env (mode 640, root:ervisio-logs).
# install.sh creates it from this template and fills ERVISIO_LOGS_SECRET_KEY with a random value.
# Every variable also accepts <NAME>_FILE pointing at a file that holds the value (not both).
# The full list, with defaults, is in .env.example at the repository root.

ERVISIO_LOGS_ENV=production
# Set here, the log level is locked; leave it commented to change it in the app (ADR 0018).
# ERVISIO_LOGS_LOG_LEVEL=info
# Listen address. Keep it on loopback and put a TLS reverse proxy in front.
ERVISIO_LOGS_HTTP_ADDR=127.0.0.1:8080
# Externally visible https URL (OAuth redirects, Secure cookies). Production refuses http.
ERVISIO_LOGS_PUBLIC_URL=https://logs.example.com
# Set to true only when the reverse proxy sets X-Forwarded-For itself.
ERVISIO_LOGS_TRUST_PROXY=true

# At least 32 characters. It keys stored API tokens: changing it invalidates them.
ERVISIO_LOGS_SECRET_KEY=

# PostgreSQL 15+ with TLS. Production refuses sslmode=disable.
ERVISIO_LOGS_POSTGRES_DSN=postgres://ervisio_logs:CHANGE_ME@127.0.0.1:5432/ervisio_logs?sslmode=verify-full

# ClickHouse 25.8 (native protocol; the HTTP URL defaults to the same host on 8123, or 8443 with TLS).
ERVISIO_LOGS_CLICKHOUSE_ADDR=127.0.0.1:9000
ERVISIO_LOGS_CLICKHOUSE_DATABASE=ervisio_logs
ERVISIO_LOGS_CLICKHOUSE_USER=ervisio_logs
ERVISIO_LOGS_CLICKHOUSE_PASSWORD=
# ERVISIO_LOGS_CLICKHOUSE_TLS=true
# ERVISIO_LOGS_CLICKHOUSE_HTTP_URL=https://127.0.0.1:8443

# Archive tier (ADR 0002/0008). ClickHouse reads archived segments from the cache with file(), so the cache
# must be a directory ClickHouse sees under its user_files path, on the same machine. install.sh points the
# cache there when it finds a local ClickHouse; with a remote ClickHouse the archive tier needs a shared mount.
# ERVISIO_LOGS_ARCHIVE_CACHE_DIR=/var/lib/clickhouse/user_files/ervisio-archive
# ERVISIO_LOGS_ARCHIVE_CLICKHOUSE_PATH=ervisio-archive
# Archive destination credentials, one file per destination (the systemd unit sets this default).
# ERVISIO_LOGS_ARCHIVE_SECRETS_DIR=/etc/ervisio-logs/secrets

# Write-ahead spool for acknowledged events. Do not put it on tmpfs.
ERVISIO_LOGS_SPOOL_DIR=/var/lib/ervisio-logs/spool

# First admin account: leave unset to have a code generated and written to the journal at start-up.
# ERVISIO_LOGS_SETUP_CODE=
# ERVISIO_LOGS_OPEN_REGISTRATION=false

# Optional: bearer token for GET /metrics.
# ERVISIO_LOGS_METRICS_TOKEN=
